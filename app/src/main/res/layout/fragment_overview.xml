<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fsploit_background"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/fs_screen_margin">

        <TextView
            style="@style/Widget.FSploit.ScreenTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/section_overview_title" />

        <TextView
            android:id="@+id/statusMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="monospace"
            android:textAppearance="@style/TextAppearance.FSploit.Body"
            android:textColor="@color/fsploit_text_secondary" />

        <!-- ===== System status ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FSploit.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_block_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.FSploit.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/root_gate_title" />

                <!-- ROOT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dotRoot"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/status_dot"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/root_gate_title"
                            android:textAppearance="@style/TextAppearance.FSploit.Label" />

                        <TextView
                            android:id="@+id/rootGateValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.FSploit.Value" />
                    </LinearLayout>
                </LinearLayout>

                <!-- PERMISSIONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dotPermission"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/status_dot"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/permission_summary"
                            android:textAppearance="@style/TextAppearance.FSploit.Label" />

                        <TextView
                            android:id="@+id/permissionSummaryValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.FSploit.Value" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TRANSPORT -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dotTransport"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/status_dot"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/active_transport"
                            android:textAppearance="@style/TextAppearance.FSploit.Label" />

                        <TextView
                            android:id="@+id/activeTransportValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.FSploit.Value" />
                    </LinearLayout>
                </LinearLayout>

                <!-- SHELL -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/dotShell"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:layout_marginTop="5dp"
                        android:src="@drawable/status_dot"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/shell_status"
                            android:textAppearance="@style/TextAppearance.FSploit.Label" />

                        <TextView
                            android:id="@+id/shellSummaryValue"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.FSploit.Value" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/fsploit_stroke" />

                <TextView
                    android:id="@+id/continueHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="monospace"
                    android:textAppearance="@style/TextAppearance.FSploit.Body"
                    android:textColor="@color/fsploit_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Interfaces ===== -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.FSploit.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_card_gap">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Widget.FSploit.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/interface_list" />

                <TextView
                    android:id="@+id/interfaceListValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.FSploit.Mono"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Actions ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fs_block_gap"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/requestPermissionsButton"
                style="@style/Widget.FSploit.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/request_permissions" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/refreshButton"
                style="@style/Widget.FSploit.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/refresh" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
