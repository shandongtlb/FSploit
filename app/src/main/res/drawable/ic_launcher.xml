<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/fsploit_background" />
    <item
        android:gravity="center"
        android:width="72dp"
        android:height="72dp">
        <shape android:shape="oval">
            <solid android:color="@color/fsploit_primary" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="28dp"
        android:height="28dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/fsploit_on_primary" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
